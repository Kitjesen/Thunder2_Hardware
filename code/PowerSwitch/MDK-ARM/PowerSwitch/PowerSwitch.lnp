"powerswitch\gpio.o"
"powerswitch\adc.o"
"powerswitch\stm32l0xx_it.o"
"powerswitch\stm32l0xx_hal_msp.o"
"powerswitch\stm32l0xx_hal_adc.o"
"powerswitch\stm32l0xx_hal_adc_ex.o"
"powerswitch\stm32l0xx_hal.o"
"powerswitch\stm32l0xx_hal_i2c.o"
"powerswitch\stm32l0xx_hal_i2c_ex.o"
"powerswitch\stm32l0xx_hal_rcc.o"
"powerswitch\stm32l0xx_hal_rcc_ex.o"
"powerswitch\stm32l0xx_hal_flash_ramfunc.o"
"powerswitch\stm32l0xx_hal_flash.o"
"powerswitch\stm32l0xx_hal_flash_ex.o"
